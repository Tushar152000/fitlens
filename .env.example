# Local development. `pnpm bootstrap` copies this to .env and fills in AUTH_SECRET and free ports.
# Every variable is validated at boot by apps/api/src/config/env.ts — that file is the reference.
# Deployed environments: see .env.production.example. Never commit .env.

# ---------- Environment ----------
# local | test | staging | production. Decides the defaults and safety rules (see docs/DEPLOY.md).
# local: dev sign-in on, mock AI, MinIO, plain http — nothing to sign up for.
APP_ENV="local"

# ---------- API (apps/api) ----------
# api = HTTP only, worker = queue consumers only, all = both (local default)
APP_ROLE="all"
PORT="4000"
LOG_LEVEL="info"
# Origin users reach the app on. The web app proxies /api to the API, so this is the web URL.
# Google OAuth redirect URI = $PUBLIC_URL/api/auth/callback/google
PUBLIC_URL="http://localhost:3000"
# Extra browser origins allowed to call the API directly (comma separated), e.g. Expo web
CORS_ORIGINS="http://localhost:8081"

# Postgres (docker compose). If a port is taken, `pnpm bootstrap` picks another and updates the URLs.
DATABASE_URL="postgresql://fitlens:fitlens@localhost:5432/fitlens?schema=public"
DATABASE_POOL_MAX="10"
# Optional. Unset = background jobs run inline and locks are per-process.
REDIS_URL="redis://localhost:6379"

# Root secret for sign-in state (32+ chars). `pnpm bootstrap` generates it.
AUTH_SECRET=""
# Optional locally: Google sign-in. https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# "Sign in with email (dev)" on web and app is on by default locally. Uncomment to test Google only.
# AUTH_DEV_LOGIN="false"
# Sessions end after this many idle days (web / app), and always after SESSION_MAX_DAYS.
SESSION_DAYS="30"
MOBILE_SESSION_DAYS="90"
SESSION_MAX_DAYS="365"
# Requests per minute per IP to each sign-in route
AUTH_RATE_LIMIT="20"

# Photo storage (MinIO locally; the API creates the bucket on boot)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fitlens-meals"
S3_ACCESS_KEY_ID="fitlens"
S3_SECRET_ACCESS_KEY="fitlens-secret"
S3_FORCE_PATH_STYLE="true"

# AI. "mock" runs the whole app (meal detection + coach agent) with scripted responses, no key needed.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_EXTRACTION_MODEL="claude-opus-5-5"
AI_COACH_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max
AI_COACH_EFFORT="medium"
# Free photo scans per user per local day (typed meals and not-food photos never count)
AI_DAILY_LIMIT="3"
# Coach messages per user per local day
COACH_DAILY_LIMIT="40"
# Contact for Open Food Facts' User-Agent (barcode lookups), optional
OFF_CONTACT=""

# ---------- Web (apps/web) ----------
# Where the Next.js server reaches the API (server components + /api rewrite)
API_INTERNAL_URL="http://localhost:4000"

# ---------- Ports ----------
# Fixed: web 3000, API 4000 (PORT above). `pnpm dev` / `pnpm dev:mobile` stop your own stale dev servers
# on these ports first; another user's or a system process is never touched.
# Expo's Metro bundler. `pnpm bootstrap` sets it only if 8081 belongs to another user or the system.
# METRO_PORT="8081"
# Docker host ports (written by `pnpm bootstrap` only when a default is taken):
# POSTGRES_PORT="5432"
# REDIS_PORT="6379"
# MINIO_PORT="9000"
# MINIO_CONSOLE_PORT="9001"

# ---------- Tests ----------
# e2e tests create and migrate this database automatically
TEST_DATABASE_URL="postgresql://fitlens:fitlens@localhost:5432/fitlens_test?schema=public"
