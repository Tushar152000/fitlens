# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose default) ---
DATABASE_URL="postgresql://fitlens:fitlens@localhost:5432/fitlens?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional email magic links via Resend (leave blank to disable)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="FitLens <login@example.com>"

# --- Storage (S3-compatible: MinIO locally, S3 or Cloudflare R2 in prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fitlens-meals"
S3_ACCESS_KEY_ID="fitlens"
S3_SECRET_ACCESS_KEY="fitlens-secret"
S3_FORCE_PATH_STYLE="true"

# --- Queue (optional: without it, meals are analysed inline in the API) ---
REDIS_URL="redis://localhost:6379"

# --- AI ---
# "mock" returns fake detections so you can build the UI with no API key.
# "anthropic" or "openai" for real detection (set the matching key).
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Set to a current vision-capable model id from your provider's docs.
AI_VISION_MODEL=""
AI_TEXT_MODEL=""
# Free photo scans per user per local day (typed meals and not-food photos never count)
AI_DAILY_LIMIT="3"
