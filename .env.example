# FITR8 local environment — the ONE env file for everything: API, web, app, database scripts, tests.
# `pnpm bootstrap` (or `pnpm start:all`) copies this to .env, generates AUTH_SECRET, picks free
# ports and keeps the URLs below in step. Deployments use real env vars (.env.production.example).
# Anything not listed here has a sensible default in apps/api/src/config/env.ts.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fitlens:fitlens@localhost:5432/fitlens?schema=public"
# generated by bootstrap (32+ characters)
AUTH_SECRET=""

# ── Local services (Docker: Postgres, Redis, MinIO — started by bootstrap) ──────────────────────
TEST_DATABASE_URL="postgresql://fitlens:fitlens@localhost:5432/fitlens_test?schema=public"
# optional: without it, jobs run inline (like production)
REDIS_URL="redis://localhost:6379"
# meal and label photos
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="fitlens"
S3_SECRET_ACCESS_KEY="fitlens-secret"
S3_FORCE_PATH_STYLE="true"

# ── Addresses ────────────────────────────────────────────────────────────────────────────────────
# the web app
PUBLIC_URL="http://localhost:3000"
# the API; the web calls it here too
API_PUBLIC_URL="http://localhost:4000"
# The app reaches the API at this laptop's Wi-Fi IP automatically. Set this only for a tunnel.
# EXPO_PUBLIC_API_URL=""

# ── AI (models are chosen in code: apps/api/src/modules/ai/models.ts) ───────────────────────────
# "openai" for real meal reading and coach
AI_PROVIDER="mock"
OPENAI_API_KEY=""

# ── Optional features (empty = off; email sign-in works locally without any of these) ───────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# APPLE_CLIENT_ID="" APPLE_TEAM_ID="" APPLE_KEY_ID="" APPLE_PRIVATE_KEY=""   # Sign in with Apple
# REVENUECAT_WEBHOOK_AUTH="" REVENUECAT_SECRET_KEY="" # FITR8 Premium store billing (unset: test purchases)
# ADMIN_EMAILS="you@gmail.com"             # Google accounts that are always admins (/admin); they invite the rest

# Extra barcode sources (optional; Open Food Facts is always on). See docs/DEPLOY.md "Barcode sources".
# USDA_FDC_API_KEY=""
# FATSECRET_CLIENT_ID=""
# FATSECRET_CLIENT_SECRET=""
# EDAMAM_APP_ID=""
# EDAMAM_APP_KEY=""
# UPCITEMDB_ENABLED="false"   # UPCitemdb is on by default; "false" turns it off
