# Rules apply at every depth (monorepo: apps/* and packages/*) unless they start with "/".

# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# generated code
packages/db/src/generated/
next-env.d.ts

# tests
coverage/

# env files (commit only the example)
.env*
!.env.example
!.env.production.example

# logs
*.log
npm-debug.log*
.pnpm-debug.log*

# local tooling
.DS_Store
*.pem
.vercel
.idea/
.claude/settings.local.json

# Local dev server logs (pnpm start:all)
.dev/

# Prisma client generated from the wrong directory (the real one is packages/db/src/generated)
/src/generated/
