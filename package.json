{
  "name": "fitlens",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bootstrap": "node scripts/local.mjs bootstrap",
    "start:all": "node scripts/local.mjs all",
    "stop:all": "node scripts/local.mjs stop",
    "dev": "node scripts/local.mjs preflight web api && turbo run dev --filter=@fitlens/api --filter=@fitlens/web",
    "dev:api": "node scripts/local.mjs preflight api && turbo run dev --filter=@fitlens/api",
    "dev:web": "node scripts/local.mjs free web && turbo run dev --filter=@fitlens/web",
    "dev:mobile": "node scripts/local.mjs mobile",
    "dev:android": "node scripts/local.mjs mobile --android",
    "emulator": "node scripts/local.mjs emulator",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait postgres redis minio",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @fitlens/db generate",
    "db:migrate": "pnpm --filter @fitlens/db migrate",
    "db:deploy": "pnpm --filter @fitlens/db deploy:migrations",
    "db:seed": "pnpm --filter @fitlens/db seed",
    "db:studio": "pnpm --filter @fitlens/db studio"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
