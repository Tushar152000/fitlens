{
  "name": "fitlens",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@fitlens/api --filter=@fitlens/web",
    "dev:api": "turbo run dev --filter=@fitlens/api",
    "dev:web": "turbo run dev --filter=@fitlens/web",
    "dev:mobile": "turbo run build --filter=@fitlens/contracts && pnpm --filter @fitlens/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @fitlens/db generate",
    "db:migrate": "pnpm --filter @fitlens/db migrate",
    "db:deploy": "pnpm --filter @fitlens/db deploy:migrations",
    "db:seed": "pnpm --filter @fitlens/db seed",
    "db:studio": "pnpm --filter @fitlens/db studio"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
