{
  "expo": {
    "name": "FitLens",
    "slug": "fitlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitlens",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tusharchauhan.fitlens",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tusharchauhan.fitlens",
      "adaptiveIcon": {
        "backgroundColor": "#17181C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "FitLens uses the camera to photograph your meals, barcodes and nutrition labels.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitLens opens a photo you pick so it can read your meal or a nutrition label.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C2410C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5e24b4b-ca8d-486a-9b73-e76452f9b624"
      }
    },
    "owner": "mrdoodler",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b5e24b4b-ca8d-486a-9b73-e76452f9b624"
    }
  }
}
