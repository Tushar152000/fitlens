{
  "name": "@fitlens/api",
  "version": "0.1.0",
  "private": true,
  "description": "FitLens backend: one NestJS service (modular monolith) for web and mobile. Runs as `api` and/or `worker`.",
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@fitlens/contracts": "workspace:*",
    "@fitlens/db": "workspace:*",
    "@fitlens/domain": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "bullmq": "^6.3.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.3",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fitlens/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
