{
  "name": "@fitr8/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the generated client. Only apps/api may depend on this.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "prisma validate",
    "migrate": "prisma migrate dev",
    "deploy:migrations": "prisma migrate deploy",
    "drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "seed": "prisma db seed",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@fitr8/domain": "workspace:*",
    "@fitr8/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
