// FITR8 data model. See PRD section 10.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  ATHLETE
}

enum DietType {
  VEG
  NON_VEG
  EGGETARIAN
  VEGAN
}

enum Experience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Equipment {
  FULL_GYM
  DUMBBELLS
  BODYWEIGHT
}

enum GoalType {
  FAT_LOSS
  MUSCLE_GAIN
  RECOMPOSITION
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  PHOTO
  TEXT
}

enum MealLogStatus {
  PENDING
  ANALYZING
  READY
  CONFIRMED
  FAILED
}

enum FoodSource {
  IFCT
  INDB
  USDA
  CUSTOM
  AI_ESTIMATE
  OPEN_FOOD_FACTS
  LABEL_SCAN
  FATSECRET
  EDAMAM
}

enum AiCallType {
  MEAL_PHOTO
  MEAL_TEXT
  WORKOUT_PLAN
  COACH_CHAT
  LABEL_SCAN
  REMINDER_PARSE
}

// ---------- Identity & auth (users module owns `users`; auth module owns the rest) ----------

model User {
  id            String    @id @default(cuid())
  /// First (preferred) name; Google/Apple fill it with the full name until onboarding step 1.
  name          String?
  lastName      String?
  /// E.164 ("+919876543210"), optional, from onboarding step 1. One account per number.
  phone         String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Last app use (GET /me, throttled to hourly). 90+ days old → "welcome back" check-in (@fitr8/domain/activity).
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identities    AuthIdentity[]
  sessions      Session[]
  authCodes     AuthCode[]
  authEvents    AuthEvent[]
  profile       Profile?
  goals         Goal[]
  dailyTargets  DailyTarget[]
  bodyMetrics   BodyMetric[]
  mealLogs      MealLog[]
  workoutPlans  WorkoutPlan[]
  workoutLogs   WorkoutLog[]
  checkins      Checkin[]
  aiCalls       AiCall[]
  labelScans    LabelScan[]
  waterLogs     WaterLog[]
  coachChats    CoachConversation[]
  coachMemories CoachMemory[]
  entitlement   Entitlement?
  savedMeals    SavedMeal[]
  reminders     Reminder[]
  staffMember   StaffMember?

  @@map("users")
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum SessionClient {
  WEB
  MOBILE
}

enum AuthEventType {
  SIGN_IN
  SIGN_IN_FAILED
  SIGN_OUT
  SIGN_OUT_ALL
  SESSION_REVOKED
}

/// A sign-in method linked to a user: one row per (provider, provider's stable user id).
/// We keep no provider access/refresh tokens: FITR8 never calls Google on the user's behalf.
model AuthIdentity {
  id                 String       @id @default(cuid())
  userId             String
  provider           AuthProvider
  /// The provider's stable subject id (Google `sub`), never the email: emails can change hands.
  subject            String
  /// Email the provider reported at the last sign-in (for support; `users.email` is the account's).
  email              String?
  /// Apple only: the refresh token, sealed with AUTH_SECRET, so deleting the account can revoke
  /// Sign in with Apple (App Store guideline 5.1.1(v)). Null when it couldn't be fetched.
  refreshTokenSealed String?
  createdAt          DateTime     @default(now())
  lastSignInAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// A signed-in device. The client holds a random 256-bit token; only its SHA-256 is stored, so a
/// database leak can't be replayed as sessions. Revoking = deleting the row.
model Session {
  id                String        @id @default(cuid())
  tokenHash         String        @unique @db.Char(64)
  userId            String
  client            SessionClient
  /// Shown in the "signed-in devices" list.
  userAgent         String?       @db.VarChar(256)
  /// Truncated (IPv4 /24, IPv6 /48): enough to recognise a place, not a household.
  ip                String?       @db.VarChar(64)
  createdAt         DateTime      @default(now())
  lastSeenAt        DateTime      @default(now())
  /// Idle expiry: slides forward while the session is used.
  expiresAt         DateTime
  /// Hard cap: the session ends here however active it is.
  absoluteExpiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time code of the app sign-in hand-off (Google → browser → app). Bound to the app's PKCE
/// challenge; deleted when redeemed, so it works exactly once. Only the hash is stored.
model AuthCode {
  codeHash    String   @id @db.Char(64)
  userId      String
  challenge   String   @db.Char(43)
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("auth_codes")
}

/// Security audit trail: sign-ins, failures, sign-outs, revocations. Kept 90 days.
model AuthEvent {
  id        String         @id @default(cuid())
  /// Null for failures before we know who it was (bad state, cancelled at Google).
  userId    String?
  type      AuthEventType
  client    SessionClient?
  /// Machine-readable cause for failures, e.g. "state_mismatch", "email_unverified".
  reason    String?        @db.VarChar(64)
  ip        String?        @db.VarChar(64)
  userAgent String?        @db.VarChar(256)
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("auth_events")
}

// ---------- Profile & goals ----------

model Profile {
  userId              String        @id
  sex                 Sex
  birthDate           DateTime      @db.Date
  heightCm            Float
  activityLevel       ActivityLevel
  dietType            DietType
  experience          Experience
  equipment           Equipment
  trainingDaysPerWeek Int           @default(3)
  sessionMinutes      Int           @default(45)
  injuries            String[]      @default([])
  // Pregnancy or a medical condition: no calorie deficit, show "consult a professional".
  medicalFlag         Boolean       @default(false)
  /// What the condition is, in the user's words (optional; kept only while medicalFlag is on).
  medicalNote         String?
  timezone            String        @default("Asia/Kolkata")
  /// Design 13 reminder switches (2 pm lunch, 9 pm dinner). Stored now; sending needs web push.
  remindLunch         Boolean       @default(false)
  remindDinner        Boolean       @default(false)
  /// Water reminders every 2 h, 9 am–9 pm; the app schedules them as local notifications.
  remindWater         Boolean       @default(false)
  onboardedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Goal {
  id               String     @id @default(cuid())
  userId           String
  type             GoalType
  startWeightKg    Float
  startBodyFatPct  Float?
  targetWeightKg   Float?
  targetBodyFatPct Float?
  startDate        DateTime   @db.Date
  targetDate       DateTime   @db.Date
  status           GoalStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTargets DailyTarget[]

  @@index([userId, status])
  @@map("goals")
}

// A new row each time targets change, so history and "why it changed" are kept.
model DailyTarget {
  id            String   @id @default(cuid())
  userId        String
  goalId        String?
  effectiveFrom DateTime @db.Date
  kcal          Int
  proteinG      Int
  carbsG        Int
  fatG          Int
  reason        String
  createdAt     DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, effectiveFrom])
  @@index([goalId])
  @@map("daily_targets")
}

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  weightKg   Float
  waistCm    Float?
  neckCm     Float?
  hipCm      Float?
  bodyFatPct Float?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("body_metrics")
}

// ---------- Food & meals ----------

model Food {
  id              String     @id @default(cuid())
  name            String     @unique
  aliases         String[]   @default([])
  source          FoodSource
  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float?
  isVeg           Boolean    @default(true)
  isLiquid        Boolean    @default(false) // drinks: portions shown in ml (1 ml ≈ 1 g)
  // Packaged foods (design: barcode scanning)
  barcode         String?    @unique
  brand           String?
  servingSizeG    Float?
  servingLabel    String? // "3 biscuits"
  imageUrl        String?
  sugarPer100g    Float?
  sodiumMgPer100g Float?
  /// Label scans start unverified: visible to their submitter only until reviewed.
  verified        Boolean    @default(false)
  submittedById   String?
  createdAt       DateTime   @default(now())

  units          FoodUnit[]
  mealItems      MealItem[]
  savedMealItems SavedMealItem[]

  @@map("foods")
}

/// Why someone deleted their account (all optional). Kept with no link to the user, who is gone:
/// only how long they had the account, so the reasons can be read by stage.
model AccountDeletionFeedback {
  id             String   @id @default(cuid())
  reasons        String[] @default([])
  feedback       String?  @db.VarChar(1000)
  accountAgeDays Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("account_deletion_feedback")
}

/// Barcodes Open Food Facts didn't know, cached for 24 h so we stay under its rate limit.
model BarcodeMiss {
  code      String   @id
  checkedAt DateTime @default(now())

  /// What a source knew without nutrition (e.g. UPCitemdb): prefills the label scan.
  name     String? @db.VarChar(200)
  brand    String? @db.VarChar(120)
  imageUrl String? @db.VarChar(500)

  @@map("barcode_misses")
}

/// A nutrition-label photo read by the AI (design 7f → 7g), before the user saves it as a Food.
model LabelScan {
  id        String   @id @default(cuid())
  userId    String
  photoKey  String
  barcode   String?
  name      String?
  extracted Json
  foodId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("label_scans")
}

// Household units → grams, e.g. roti/piece = 40 g, dal/katori = 150 g.
model FoodUnit {
  id     String @id @default(cuid())
  foodId String
  unit   String
  grams  Float

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, unit])
  @@map("food_units")
}

// A meal log doubles as the AI job record: PENDING → ANALYZING → READY → CONFIRMED.
model MealLog {
  id           String        @id @default(cuid())
  userId       String
  date         DateTime      @db.Date
  mealType     MealType
  source       MealSource
  photoKey     String?
  inputText    String?
  status       MealLogStatus @default(PENDING)
  aiRaw        Json?
  aiNotes      String?
  note         String? // the user's own details ("small cup, 2 sachets sugar"), also sent to the AI on re-check
  error        String?
  totalKcal    Float         @default(0)
  totalProtein Float         @default(0)
  totalCarbs   Float         @default(0)
  totalFat     Float         @default(0)
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, date])
  @@map("meal_logs")
}

model MealItem {
  id           String  @id @default(cuid())
  mealLogId    String
  foodId       String?
  name         String
  quantity     Float
  unit         String
  grams        Float
  kcal         Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  // What the AI originally said, kept to measure accuracy and learn from edits.
  aiConfidence Float?
  aiGrams      Float?
  approximate  Boolean @default(false)
  edited       Boolean @default(false)
  isLiquid     Boolean @default(false)

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  food    Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([mealLogId])
  @@index([foodId])
  @@map("meal_items")
}

// ---------- Workouts & check-ins ----------

/// Exercise library; the source of truth is src/lib/training/library.ts (seeded).
model Exercise {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  muscleGroup String
  /// Set-ups where it can be done (a gym user can also do dumbbell/bodyweight moves).
  equipment   Equipment[]
  /// Programming slot, e.g. horizontal_push, hinge (docs/DESIGN.md → coach engine §3–4).
  slot        String      @default("")
  isMain      Boolean     @default(false)
  /// Injury keywords that rule it out ("knee", "lower back", "shoulder").
  avoidIf     String[]    @default([])
  loadStepKg  Float       @default(0)
  /// Held for time (plank): reps are seconds.
  timed       Boolean     @default(false)
  videoUrl    String?

  @@map("exercises")
}

model WorkoutPlan {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  split     String
  plan      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs WorkoutLog[]

  @@unique([userId, weekStart, version])
  @@map("workout_plans")
}

model WorkoutLog {
  id           String   @id @default(cuid())
  userId       String
  planId       String
  date         DateTime @db.Date
  exerciseSlug String
  sets         Json
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([planId])
  @@map("workout_logs")
}

model Checkin {
  id           String   @id @default(cuid())
  userId       String
  weekStart    DateTime @db.Date
  avgWeightKg  Float
  adherencePct Float?
  adjustment   Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("checkins")
}

// ---------- Observability ----------

model AiCall {
  id           String     @id @default(cuid())
  userId       String?
  type         AiCallType
  provider     String
  model        String
  tokensIn     Int?
  tokensOut    Int?
  latencyMs    Int
  success      Boolean
  error        String?
  /// Counts against the daily photo-scan limit. False for typed meals, not-food results and our own failures.
  countsAsScan Boolean    @default(false)
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_calls")
}

/// Water drunk, one row per tap ("+ Glass 250 ml"). The daily target is computed, not stored.
model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date // the user's local date
  ml        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("water_logs")
}

/// A user's own repeat meal ("My breakfast"): priced items saved once, logged with one tap. Meals module.
model SavedMeal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  /// The slot it's usually eaten in; only a default when logging.
  mealType     MealType?
  totalKcal    Float     @default(0)
  totalProtein Float     @default(0)
  totalCarbs   Float     @default(0)
  totalFat     Float     @default(0)
  timesLogged  Int       @default(0)
  lastLoggedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedMealItem[]

  @@index([userId])
  @@map("saved_meals")
}

model SavedMealItem {
  id          String  @id @default(cuid())
  savedMealId String
  position    Int
  foodId      String?
  name        String
  quantity    Float
  unit        String
  grams       Float
  kcal        Float
  proteinG    Float
  carbsG      Float
  fatG        Float
  approximate Boolean @default(false)
  isLiquid    Boolean @default(false)

  savedMeal SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  food      Food?     @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([savedMealId])
  @@index([foodId])
  @@map("saved_meal_items")
}

/// A user's reminder. Only the config lives here: the phone schedules it as local notifications.
model Reminder {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  /// One or more 5-field cron rules in the phone's local time (domain `parseRules`: L, L-1, 1#1, 5L, months).
  crons       String[]
  enabled     Boolean  @default(true)
  /// The user's own words it was made from.
  prompt      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminders")
}

// ---------- AI coach (agent loop) ----------

/// One chat thread with the AI coach. The transcript is append-only (prompt caching + preserved thinking).
model CoachConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt])
  @@map("coach_conversations")
}

/// One turn. `content` holds the Anthropic content blocks verbatim (text, tool_use, tool_result,
/// thinking, compaction) so the transcript can be replayed byte-for-byte; `text` is the display copy.
model CoachMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String // "user" | "assistant"
  content         Json
  text            String   @default("")
  /// Human labels of tools used in this turn ("Checked today's meals").
  actions         String[] @default([])
  tokensIn        Int?
  tokensOut       Int?
  cacheReadTokens Int?
  createdAt       DateTime @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}

/// A lasting fact the coach keeps about the user across chats ("left knee pain", "trains at 6 am",
/// "lactose intolerant"). Written by the coach's `remember` tool, shown to and deletable by the user.
/// Owned by `coach`.
model CoachMemory {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.VarChar(300)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coach_memories")
}

/// The coach's science notes (packages/db/prisma/data/knowledge/*.md, loaded by the seed): written in
/// FITR8's own words, each with its sources. Searched with Postgres full-text search (GIN index on
/// title + keywords + body, created in the migration). Owned by `coach`.
model KnowledgeNote {
  slug      String   @id
  title     String
  topic     String
  keywords  String   @default("")
  body      String
  sources   String[] @default([])
  reviewed  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("knowledge_notes")
}

/// FITR8 Pro access from RevenueCat, one row per user who has ever subscribed. Owned by `billing`.
model Entitlement {
  userId      String    @id
  /// Pro until this moment (store expiry, or the billing grace period). Ignored when `lifetime`.
  proUntil    DateTime?
  lifetime    Boolean   @default(false)
  willRenew   Boolean   @default(true)
  productId   String?
  /// APP_STORE, PLAY_STORE… (where to manage the subscription)
  store       String?
  /// TRIAL, INTRO, NORMAL, PROMOTIONAL, PREPAID
  periodType  String?
  /// SANDBOX or PRODUCTION
  environment String?
  /// Time of the newest state applied (webhook event time or REST sync), so a late, older webhook
  /// can't undo it.
  syncedAt    DateTime
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

/// RevenueCat webhook deliveries already handled (retries reuse the event id). Owned by `billing`.
model BillingEvent {
  /// RevenueCat's event id.
  id         String   @id
  type       String
  userId     String?
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("billing_events")
}

// ---------- Admin (modules/admin) ----------
// The staff admin at /admin. Staff sign in with their normal Google account; a staff_members row
// gives them a role across every admin section (blog first). Sections keep their own data.

enum StaffRole {
  /// Everything, including the team.
  ADMIN
  /// Runs content: publishes, edits everyone's work, manages taxonomies and settings of a section.
  EDITOR
  /// Contributes: writes their own drafts.
  AUTHOR
}

/// Who can open /admin. `email` alone (no userId) is an invite; the first admin visit by a user with
/// that email links userId.
model StaffMember {
  id        String    @id @default(cuid())
  userId    String?   @unique
  /// Lower-cased. Unique so an invite matches exactly one person.
  email     String    @unique
  name      String
  role      StaffRole @default(AUTHOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  blogAuthor    BlogAuthor?
  blogRevisions BlogRevision[]
  blogUploads   BlogMedia[]

  @@map("staff_members")
}

// ---------- Blog (modules/blog) ----------
// The public blog at /blog and its admin section at /admin/blog. Who may do what comes from the
// staff role (admin module); the blog owns only blog data, including public author profiles.

enum BlogPostStatus {
  DRAFT
  /// Goes live by itself once publishedAt has passed (readers' queries check the time; no job).
  SCHEDULED
  PUBLISHED
}

/// A staff member's public author profile (/blog/author/<slug>), made the first time they write.
model BlogAuthor {
  staffId   String   @id
  slug      String   @unique
  name      String
  bio       String?
  avatarId  String?
  website   String?
  twitter   String?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff  StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  avatar BlogMedia?  @relation("BlogAuthorAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  posts  BlogPost[]

  @@index([avatarId])
  @@map("blog_authors")
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String?
  /// Tiptap document (what the editor loads).
  contentJson     Json
  /// Sanitised HTML rendered on /blog (headings carry ids for the table of contents).
  contentHtml     String
  /// Plain text: word count, search, and the SEO checks.
  contentText     String
  /// [{ id, text, level }] of the h2/h3 headings.
  toc             Json           @default("[]")
  wordCount       Int            @default(0)
  readingMinutes  Int            @default(0)
  status          BlogPostStatus @default(DRAFT)
  /// When it went (or goes) live. Kept when unpublished so a re-publish keeps the original date.
  publishedAt     DateTime?
  featured        Boolean        @default(false)
  coverId         String?
  coverAlt        String?
  /// The author's staff id (blog_authors.staffId).
  authorId        String?
  categoryId      String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  noindex         Boolean        @default(false)
  ogImageId       String?
  focusKeyword    String?
  /// [{ question, answer }]: rendered under the post and as FAQPage structured data.
  faq             Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  author    BlogAuthor?    @relation(fields: [authorId], references: [staffId], onDelete: SetNull)
  category  BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cover     BlogMedia?     @relation("BlogPostCover", fields: [coverId], references: [id], onDelete: SetNull)
  ogImage   BlogMedia?     @relation("BlogPostOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  tags      BlogPostTag[]
  revisions BlogRevision[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([coverId])
  @@index([ogImageId])
  @@map("blog_posts")
}

model BlogCategory {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String     @unique
  description     String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  posts           BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  posts       BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

/// A snapshot of a post's words, taken on publish, on restore and at most every few minutes while
/// editing. Newest 50 per post are kept.
model BlogRevision {
  id          String   @id @default(cuid())
  postId      String
  title       String
  excerpt     String?
  contentJson Json
  contentHtml String
  /// Why it was taken: "autosave", "publish", "schedule", "restore", "manual".
  reason      String
  staffId     String?
  createdAt   DateTime @default(now())

  post  BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  staff StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([staffId])
  @@map("blog_revisions")
}

/// /blog/<fromSlug> → toPath. Made automatically when a published post's slug changes, or by hand.
model BlogRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  /// A site path ("/blog/new-slug") or an https URL.
  toPath    String
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("blog_redirects")
}

/// An uploaded blog image. Public by design: served by GET /api/blog/media/<file>.
model BlogMedia {
  id           String   @id @default(cuid())
  /// Storage key: blog/<uuid>.<ext>
  key          String   @unique
  contentType  String
  alt          String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy StaffMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  covers     BlogPost[]   @relation("BlogPostCover")
  ogImages   BlogPost[]   @relation("BlogPostOgImage")
  avatars    BlogAuthor[] @relation("BlogAuthorAvatar")

  @@index([uploadedById])
  @@map("blog_media")
}
