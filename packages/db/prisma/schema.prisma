// FITR8 data model. See PRD section 10.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  ATHLETE
}

enum DietType {
  VEG
  NON_VEG
  EGGETARIAN
  VEGAN
}

enum Experience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Equipment {
  FULL_GYM
  DUMBBELLS
  BODYWEIGHT
}

enum GoalType {
  FAT_LOSS
  MUSCLE_GAIN
  RECOMPOSITION
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  PHOTO
  TEXT
}

enum MealLogStatus {
  PENDING
  ANALYZING
  READY
  CONFIRMED
  FAILED
}

enum FoodSource {
  IFCT
  INDB
  USDA
  CUSTOM
  AI_ESTIMATE
  OPEN_FOOD_FACTS
  LABEL_SCAN
}

enum AiCallType {
  MEAL_PHOTO
  MEAL_TEXT
  WORKOUT_PLAN
  COACH_CHAT
  LABEL_SCAN
}

// ---------- Identity & auth (users module owns `users`; auth module owns the rest) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identities   AuthIdentity[]
  sessions     Session[]
  authCodes    AuthCode[]
  authEvents   AuthEvent[]
  profile      Profile?
  goals        Goal[]
  dailyTargets DailyTarget[]
  bodyMetrics  BodyMetric[]
  mealLogs     MealLog[]
  workoutPlans WorkoutPlan[]
  workoutLogs  WorkoutLog[]
  checkins     Checkin[]
  aiCalls      AiCall[]
  labelScans   LabelScan[]
  waterLogs    WaterLog[]
  coachChats   CoachConversation[]
  entitlement  Entitlement?

  @@map("users")
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum SessionClient {
  WEB
  MOBILE
}

enum AuthEventType {
  SIGN_IN
  SIGN_IN_FAILED
  SIGN_OUT
  SIGN_OUT_ALL
  SESSION_REVOKED
}

/// A sign-in method linked to a user: one row per (provider, provider's stable user id).
/// We keep no provider access/refresh tokens: FITR8 never calls Google on the user's behalf.
model AuthIdentity {
  id                 String       @id @default(cuid())
  userId             String
  provider           AuthProvider
  /// The provider's stable subject id (Google `sub`), never the email: emails can change hands.
  subject            String
  /// Email the provider reported at the last sign-in (for support; `users.email` is the account's).
  email              String?
  /// Apple only: the refresh token, sealed with AUTH_SECRET, so deleting the account can revoke
  /// Sign in with Apple (App Store guideline 5.1.1(v)). Null when it couldn't be fetched.
  refreshTokenSealed String?
  createdAt          DateTime     @default(now())
  lastSignInAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// A signed-in device. The client holds a random 256-bit token; only its SHA-256 is stored, so a
/// database leak can't be replayed as sessions. Revoking = deleting the row.
model Session {
  id                String        @id @default(cuid())
  tokenHash         String        @unique @db.Char(64)
  userId            String
  client            SessionClient
  /// Shown in the "signed-in devices" list.
  userAgent         String?       @db.VarChar(256)
  /// Truncated (IPv4 /24, IPv6 /48): enough to recognise a place, not a household.
  ip                String?       @db.VarChar(64)
  createdAt         DateTime      @default(now())
  lastSeenAt        DateTime      @default(now())
  /// Idle expiry: slides forward while the session is used.
  expiresAt         DateTime
  /// Hard cap: the session ends here however active it is.
  absoluteExpiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time code of the app sign-in hand-off (Google → browser → app). Bound to the app's PKCE
/// challenge; deleted when redeemed, so it works exactly once. Only the hash is stored.
model AuthCode {
  codeHash    String   @id @db.Char(64)
  userId      String
  challenge   String   @db.Char(43)
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_codes")
}

/// Security audit trail: sign-ins, failures, sign-outs, revocations. Kept 90 days.
model AuthEvent {
  id        String         @id @default(cuid())
  /// Null for failures before we know who it was (bad state, cancelled at Google).
  userId    String?
  type      AuthEventType
  client    SessionClient?
  /// Machine-readable cause for failures, e.g. "state_mismatch", "email_unverified".
  reason    String?        @db.VarChar(64)
  ip        String?        @db.VarChar(64)
  userAgent String?        @db.VarChar(256)
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("auth_events")
}

// ---------- Profile & goals ----------

model Profile {
  userId              String        @id
  sex                 Sex
  birthDate           DateTime      @db.Date
  heightCm            Float
  activityLevel       ActivityLevel
  dietType            DietType
  experience          Experience
  equipment           Equipment
  trainingDaysPerWeek Int           @default(3)
  sessionMinutes      Int           @default(45)
  injuries            String[]      @default([])
  // Pregnancy or a medical condition: no calorie deficit, show "consult a professional".
  medicalFlag         Boolean       @default(false)
  timezone            String        @default("Asia/Kolkata")
  /// Design 13 reminder switches (2 pm lunch, 9 pm dinner). Stored now; sending needs web push.
  remindLunch         Boolean       @default(false)
  remindDinner        Boolean       @default(false)
  /// Water reminders every 2 h, 9 am–9 pm; the app schedules them as local notifications.
  remindWater         Boolean       @default(false)
  onboardedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Goal {
  id               String     @id @default(cuid())
  userId           String
  type             GoalType
  startWeightKg    Float
  startBodyFatPct  Float?
  targetWeightKg   Float?
  targetBodyFatPct Float?
  startDate        DateTime   @db.Date
  targetDate       DateTime   @db.Date
  status           GoalStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTargets DailyTarget[]

  @@index([userId, status])
  @@map("goals")
}

// A new row each time targets change, so history and "why it changed" are kept.
model DailyTarget {
  id            String   @id @default(cuid())
  userId        String
  goalId        String?
  effectiveFrom DateTime @db.Date
  kcal          Int
  proteinG      Int
  carbsG        Int
  fatG          Int
  reason        String
  createdAt     DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, effectiveFrom])
  @@map("daily_targets")
}

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  weightKg   Float
  waistCm    Float?
  neckCm     Float?
  hipCm      Float?
  bodyFatPct Float?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("body_metrics")
}

// ---------- Food & meals ----------

model Food {
  id              String     @id @default(cuid())
  name            String     @unique
  aliases         String[]   @default([])
  source          FoodSource
  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float?
  isVeg           Boolean    @default(true)
  isLiquid        Boolean    @default(false) // drinks: portions shown in ml (1 ml ≈ 1 g)
  // Packaged foods (design: barcode scanning)
  barcode         String?    @unique
  brand           String?
  servingSizeG    Float?
  servingLabel    String? // "3 biscuits"
  imageUrl        String?
  sugarPer100g    Float?
  sodiumMgPer100g Float?
  /// Label scans start unverified: visible to their submitter only until reviewed.
  verified        Boolean    @default(false)
  submittedById   String?
  createdAt       DateTime   @default(now())

  units     FoodUnit[]
  mealItems MealItem[]

  @@map("foods")
}

/// Barcodes Open Food Facts didn't know, cached for 24 h so we stay under its rate limit.
model BarcodeMiss {
  code      String   @id
  checkedAt DateTime @default(now())

  @@map("barcode_misses")
}

/// A nutrition-label photo read by the AI (design 7f → 7g), before the user saves it as a Food.
model LabelScan {
  id        String   @id @default(cuid())
  userId    String
  photoKey  String
  barcode   String?
  name      String?
  extracted Json
  foodId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("label_scans")
}

// Household units → grams, e.g. roti/piece = 40 g, dal/katori = 150 g.
model FoodUnit {
  id     String @id @default(cuid())
  foodId String
  unit   String
  grams  Float

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, unit])
  @@map("food_units")
}

// A meal log doubles as the AI job record: PENDING → ANALYZING → READY → CONFIRMED.
model MealLog {
  id           String        @id @default(cuid())
  userId       String
  date         DateTime      @db.Date
  mealType     MealType
  source       MealSource
  photoKey     String?
  inputText    String?
  status       MealLogStatus @default(PENDING)
  aiRaw        Json?
  aiNotes      String?
  note         String? // the user's own details ("small cup, 2 sachets sugar"), also sent to the AI on re-check
  error        String?
  totalKcal    Float         @default(0)
  totalProtein Float         @default(0)
  totalCarbs   Float         @default(0)
  totalFat     Float         @default(0)
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, date])
  @@map("meal_logs")
}

model MealItem {
  id           String  @id @default(cuid())
  mealLogId    String
  foodId       String?
  name         String
  quantity     Float
  unit         String
  grams        Float
  kcal         Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  // What the AI originally said, kept to measure accuracy and learn from edits.
  aiConfidence Float?
  aiGrams      Float?
  approximate  Boolean @default(false)
  edited       Boolean @default(false)
  isLiquid     Boolean @default(false)

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  food    Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([mealLogId])
  @@map("meal_items")
}

// ---------- Workouts & check-ins ----------

/// Exercise library; the source of truth is src/lib/training/library.ts (seeded).
model Exercise {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  muscleGroup String
  /// Set-ups where it can be done (a gym user can also do dumbbell/bodyweight moves).
  equipment   Equipment[]
  /// Programming slot, e.g. horizontal_push, hinge (docs/DESIGN.md → coach engine §3–4).
  slot        String      @default("")
  isMain      Boolean     @default(false)
  /// Injury keywords that rule it out ("knee", "lower back", "shoulder").
  avoidIf     String[]    @default([])
  loadStepKg  Float       @default(0)
  /// Held for time (plank): reps are seconds.
  timed       Boolean     @default(false)
  videoUrl    String?

  @@map("exercises")
}

model WorkoutPlan {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  split     String
  plan      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs WorkoutLog[]

  @@unique([userId, weekStart, version])
  @@map("workout_plans")
}

model WorkoutLog {
  id           String   @id @default(cuid())
  userId       String
  planId       String
  date         DateTime @db.Date
  exerciseSlug String
  sets         Json
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("workout_logs")
}

model Checkin {
  id           String   @id @default(cuid())
  userId       String
  weekStart    DateTime @db.Date
  avgWeightKg  Float
  adherencePct Float?
  adjustment   Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("checkins")
}

// ---------- Observability ----------

model AiCall {
  id           String     @id @default(cuid())
  userId       String?
  type         AiCallType
  provider     String
  model        String
  tokensIn     Int?
  tokensOut    Int?
  latencyMs    Int
  success      Boolean
  error        String?
  /// Counts against the daily photo-scan limit. False for typed meals, not-food results and our own failures.
  countsAsScan Boolean    @default(false)
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_calls")
}

/// Water drunk, one row per tap ("+ Glass 250 ml"). The daily target is computed, not stored.
model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date // the user's local date
  ml        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("water_logs")
}

// ---------- AI coach (agent loop) ----------

/// One chat thread with the AI coach. The transcript is append-only (prompt caching + preserved thinking).
model CoachConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt])
  @@map("coach_conversations")
}

/// One turn. `content` holds the Anthropic content blocks verbatim (text, tool_use, tool_result,
/// thinking, compaction) so the transcript can be replayed byte-for-byte; `text` is the display copy.
model CoachMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String // "user" | "assistant"
  content         Json
  text            String   @default("")
  /// Human labels of tools used in this turn ("Checked today's meals").
  actions         String[] @default([])
  tokensIn        Int?
  tokensOut       Int?
  cacheReadTokens Int?
  createdAt       DateTime @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}

/// FITR8 Pro access from RevenueCat, one row per user who has ever subscribed. Owned by `billing`.
model Entitlement {
  userId      String    @id
  /// Pro until this moment (store expiry, or the billing grace period). Ignored when `lifetime`.
  proUntil    DateTime?
  lifetime    Boolean   @default(false)
  willRenew   Boolean   @default(true)
  productId   String?
  /// APP_STORE, PLAY_STORE… (where to manage the subscription)
  store       String?
  /// TRIAL, INTRO, NORMAL, PROMOTIONAL, PREPAID
  periodType  String?
  /// SANDBOX or PRODUCTION
  environment String?
  /// Time of the newest state applied (webhook event time or REST sync), so a late, older webhook
  /// can't undo it.
  syncedAt    DateTime
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

/// RevenueCat webhook deliveries already handled (retries reuse the event id). Owned by `billing`.
model BillingEvent {
  /// RevenueCat's event id.
  id         String   @id
  type       String
  userId     String?
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("billing_events")
}
