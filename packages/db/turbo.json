{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // `prisma generate` writes the client into src/generated: cache it, or a cache hit leaves it missing.
    "build": { "outputs": ["$TURBO_EXTENDS$", "src/generated/**"] },
    // Both run `prisma generate` into src/generated; in parallel they race (ENOTEMPTY on rmdir).
    "typecheck": { "dependsOn": ["$TURBO_EXTENDS$", "build"], "outputs": ["src/generated/**"] }
  }
}
