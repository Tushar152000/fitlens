# Deployed environments (staging and production). A template for your host's settings page or
# secret manager — deployments read real environment variables, never a .env file.
# The API refuses to boot if a deployed config is unsafe: no Google keys, plain http, dev sign-in.
# Reference: apps/api/src/config/env.ts and docs/DEPLOY.md.

# ---------- Required ----------
APP_ENV="production"                     # or "staging"
NODE_ENV="production"                    # set by the Docker images already
PUBLIC_URL="https://www.fitr8.com"       # the web app's origin (sign-in returns here; allowed by CORS)
API_PUBLIC_URL="https://api.fitr8.com"   # this API's origin; Google redirect = $API_PUBLIC_URL/api/auth/callback/google
AUTH_COOKIE_DOMAIN=".fitr8.com"          # session cookie shared by www + api
DATABASE_URL=""                          # pooled connection string
AUTH_SECRET=""                           # openssl rand -base64 33 — one per environment, keep it stable
AUTH_GOOGLE_ID=""                        # one OAuth client per environment
AUTH_GOOGLE_SECRET=""
APPLE_CLIENT_ID="com.fitr8.app"         # Sign in with Apple; then the three below are required
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""                     # contents of AuthKey_<KEY_ID>.p8 (Secret Manager)
S3_ENDPOINT=""                           # S3 or Cloudflare R2
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
AI_PROVIDER="openai"                     # or "anthropic"
OPENAI_API_KEY=""                        # or ANTHROPIC_API_KEY for anthropic

# ---------- Per process ----------
APP_ROLE="api"                           # the worker deployment sets "worker"

# ---------- Recommended ----------
REDIS_URL=""                             # background jobs, cross-instance locks
CORS_ORIGINS=""                          # only if a browser origin other than PUBLIC_URL calls the API
PAYWALL_ENABLED="false"                  # "true" applies the free limits; then the two below are required
REVENUECAT_WEBHOOK_AUTH=""               # RevenueCat webhook Authorization header value
REVENUECAT_SECRET_KEY=""                 # RevenueCat secret API key (sk_…)

# ---------- Optional (defaults shown) ----------
# LOG_LEVEL="info"
# DATABASE_POOL_MAX="10"
# SESSION_DAYS="30"
# MOBILE_SESSION_DAYS="90"
# SESSION_MAX_DAYS="365"
# AUTH_RATE_LIMIT="20"
# AI_DAILY_LIMIT="3"
# COACH_DAILY_LIMIT="40"
# OFF_CONTACT=""
